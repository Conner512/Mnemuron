[Unit]
Description=Private Qdrant vector projection store
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=qdrant
Group=qdrant
WorkingDirectory=/var/lib/qdrant
EnvironmentFile=/etc/qdrant/runtime.env
ExecStartPre=/bin/sh -c 'test -n "$$QDRANT__SERVICE__API_KEY"'
ExecStart=/opt/qdrant/current/qdrant --config-path /etc/qdrant/config.yaml
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/var/lib/qdrant
CapabilityBoundingSet=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryHigh=1536M
MemoryMax=2G
CPUQuota=150%
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
