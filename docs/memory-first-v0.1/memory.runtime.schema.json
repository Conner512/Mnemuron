{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mnemuron Memory First runtime configuration",
  "type": "object",
  "required": ["config_version", "modules"],
  "properties": {
    "console": {"type":"object","additionalProperties":false,"properties":{"key_file":{"type":"string","pattern":"^/"},"worker_enabled":{"type":"boolean"},"personal_vectors":{"type":"boolean"},"allowed_private_origins":{"type":"array","maxItems":32,"items":{"type":"string"}}}},
    "config_version": {"const": "mnemuron-memory-first-v1"},
    "deployment_mode": {"enum": ["production", "test", "development"]},
    "development": {"type": "object", "properties": {"synthetic_data": {"type": "boolean"}}},
    "modules": {
      "type": "object", "required": ["memory", "handoff"],
      "properties": {
        "memory": {"type": "object", "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
        "handoff": {"type": "object", "required": ["enabled", "existing_inflight_policy"], "properties": {
          "enabled": {"type": "boolean"}, "existing_inflight_policy": {"const": "drain_before_disable"}
        }}
      }
    },
    "storage": {"type": "object", "properties": {"sqlite_path": {"type": "string", "pattern": "^/"}, "reject_private_paths_inside_git_worktree": {"const": true}}},
    "memory": {
      "type": "object", "properties": {
        "preserve_atomic_records": {"const": true}, "automatic_fact_overwrite": {"const": false},
        "capture_extraction": {"type": "object", "properties": {"enabled": {"type": "boolean"}}},
        "taxonomy": {"type": "object", "required": ["version", "categories"], "additionalProperties": false, "properties": {
          "version": {"$ref": "#/$defs/name"}, "categories": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
            "contains": {"const": "uncategorized"}, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}}
        }},
        "retrieval": {"type": "object", "properties": {"mode": {"enum": ["lexical", "hybrid", "semantic"]}}}
      }
    },
    "providers": {"type": "object", "additionalProperties": false, "properties": {"organizer": {"$ref": "#/$defs/profile"}, "embedder": {"$ref": "#/$defs/embeddingProfile"}}},
    "jobs": {"type": "object", "required": ["enabled"], "additionalProperties": false, "properties": {
      "enabled": {"type": "boolean"}, "lease_ms": {"type": "integer", "minimum": 100, "maximum": 600000},
      "concurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "batch_size": {"type": "integer", "minimum": 1, "maximum": 128},
      "poll_ms": {"type": "integer", "minimum": 1000, "maximum": 3600000}, "timezone": {"type": "string", "minLength": 1},
      "periods": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["daily", "weekly"]}}
    }},
    "privacy": {"type": "object", "properties": {"include_body_in_logs": {"const": false}, "automatic_export": {"const": false}}},
    "vector_store": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {
      "enabled": {"type": "boolean"}, "protocol": {"const": "qdrant-rest-v1.19"}, "base_url": {"type": "string", "format": "uri"},
      "auth": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": false, "properties": {"env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,100}$"}, "secret_file": {"type": "string", "pattern": "^/"}}},
      "collection_prefix": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$"},
      "egress": {"type": "object", "required": ["approved", "origins", "addresses", "allow_private"], "additionalProperties": false, "properties": {
        "approved": {"const": true}, "allow_private": {"const": true}, "origins": {"$ref": "#/$defs/stringList"}, "addresses": {"$ref": "#/$defs/stringList"}
      }},
      "timeouts": {"$ref": "#/$defs/timeouts"}, "limits": {"type": "object", "required": ["input_bytes", "output_bytes"], "additionalProperties": false, "properties": {"input_bytes": {"$ref": "#/$defs/bytes"}, "output_bytes": {"$ref": "#/$defs/bytes"}}}
    }, "if": {"properties": {"enabled": {"const": true}}}, "then": {"required": ["protocol", "base_url", "auth", "collection_prefix", "egress", "timeouts", "limits"]}}
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
    "tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "stringList": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
    "timeouts": {"type": "object", "additionalProperties": false, "required": ["request_ms"], "properties": {"request_ms": {"type": "integer", "minimum": 1, "maximum": 120000}}},
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"}, "provider_id": {"$ref": "#/$defs/name"}, "protocol": {"enum": ["openai_compatible", "ollama", "mock"]},
        "base_url": {"type": "string", "format": "uri"}, "model": {"$ref": "#/$defs/name"}, "profile_revision": {"$ref": "#/$defs/name"},
        "auth": {"type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": false, "properties": {
          "env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,100}$"}, "secret_file": {"type": "string", "pattern": "^/"}, "none": {"const": true}
        }},
        "timeouts": {"$ref": "#/$defs/timeouts"},
        "limits": {"type": "object", "additionalProperties": false, "required": ["input_bytes", "input_tokens", "output_bytes", "output_tokens", "batch_size", "concurrency", "daily_requests"], "properties": {
          "input_bytes": {"$ref": "#/$defs/bytes"}, "output_bytes": {"$ref": "#/$defs/bytes"}, "input_tokens": {"$ref": "#/$defs/tokens"}, "output_tokens": {"$ref": "#/$defs/tokens"},
          "batch_size": {"type": "integer", "minimum": 1, "maximum": 128}, "concurrency": {"type": "integer", "minimum": 1, "maximum": 16}, "daily_requests": {"type": "integer", "minimum": 1, "maximum": 1000000}
        }},
        "retry": {"type": "object", "additionalProperties": false, "required": ["max_attempts", "base_ms", "max_ms"], "properties": {
          "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10}, "base_ms": {"type": "integer", "minimum": 1, "maximum": 60000},
          "max_ms": {"type": "integer", "minimum": 1, "maximum": 3600000}, "repair_once": {"type": "boolean"}
        }},
        "capabilities": {"type": "object", "additionalProperties": false, "required": ["native_schema"], "properties": {"native_schema": {"type": "boolean"}}},
        "egress": {"type": "object", "additionalProperties": false, "required": ["approved", "origins", "addresses", "allow_private", "sensitivities", "query_approved"], "properties": {
          "approved": {"type": "boolean"}, "query_approved": {"type": "boolean"}, "allow_private": {"type": "boolean"},
          "origins": {"$ref": "#/$defs/stringList"}, "addresses": {"$ref": "#/$defs/stringList"},
          "sensitivities": {"type": "array", "maxItems": 64, "items": {"enum": ["public", "internal", "sensitive"]}}
        }},
        "paths": {"type": "object", "additionalProperties": false, "properties": {"chat": {"type": "string", "pattern": "^/[a-zA-Z0-9_/-]+$"}, "embed": {"type": "string", "pattern": "^/[a-zA-Z0-9_/-]+$"}}},
        "dimensions": {"type": "integer", "minimum": 1, "maximum": 65536}, "distance": {"enum": ["Cosine", "Dot", "Euclid"]},
        "query_prefix": {"type": "string", "maxLength": 512}, "document_prefix": {"type": "string", "maxLength": 512},
        "normalization": {"enum": ["none", "l2"]}, "chunker_version": {"$ref": "#/$defs/name"}
      },
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"required": ["provider_id", "protocol", "model", "profile_revision", "auth", "timeouts", "limits", "retry", "capabilities", "egress"],
        "if": {"properties": {"protocol": {"enum": ["openai_compatible", "ollama"]}}}, "then": {"required": ["base_url"]}}
    },
    "embeddingProfile": {"type": "object", "allOf": [{"$ref": "#/$defs/profile"}, {"if": {"properties": {"enabled": {"const": true}}}, "then": {"required": ["dimensions", "distance", "query_prefix", "document_prefix", "normalization", "chunker_version"]}}]}
  }
}
