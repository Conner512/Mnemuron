[Unit]
Description=Mnemuron shared memory service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mnemuron
Group=mnemuron
WorkingDirectory=/opt/mnemuron/server
EnvironmentFile=/etc/mnemuron/mnemuron.env
ExecStart=/opt/mnemuron/node/bin/node /opt/mnemuron/server/bin/mnemuron-server.mjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mnemuron

[Install]
WantedBy=multi-user.target
